   "source": [
    "## Using ``console.table()``\n",
    "\n",
    "Displays dictionaries and list in a table"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0781c547",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "┌───────┬─────────┬─────┐\n",
      "│ (idx) │ name    │ age │\n",
      "├───────┼─────────┼─────┤\n",
      "│     0 │ \"Alice\" │  25 │\n",
      "│     1 │ \"Bob\"   │  30 │\n",
      "└───────┴─────────┴─────┘\n"
     ]
    }
   ],
   "source": [
    "let users = [\n",
    "  { name: \"Alice\", age: 25 },\n",
    "  { name: \"Bob\", age: 30 }\n",
    "]\n",
    "console.table(users)"
   ]
  }
